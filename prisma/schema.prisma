// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id String @id @default(uuid())
  name String 
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
}

enum MessageRole {
  USER
  ASSISTANT
}
enum MessageType {
  RESULT
  ERROR
}

model Message {
  id String @id @default(uuid())
  content String
  role MessageRole
  type MessageType
  projectId String?  
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade) 

  fragment Fragment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fragment {
    id          String   @id @default(uuid())
    messageId   String   @unique
    message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
    sandboxUrl  String?  
    sandboxId   String?  
    title       String
    files       Json
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Usage {
  key String @id
  points Int
  expire DateTime?
}

model HtmlCode {
  id        String   @id @default(uuid())
  title     String
  category  String
  image     String   // Image URL
  code      String   // Full HTML code will be stored here
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



// Add to your schema.prisma

model PromptTemplate {
  id          String   @id @default(uuid())
  name        String   @unique // "ui-generation", "response-generation", "fragment-title"
  version     Int      @default(1)
  content     String   @db.Text
  isActive    Boolean  @default(true)
  
  // Configuration
  metadata    Json?    // { temperature: 0.1, model: "gpt-4", maxTokens: 4000 }
  
  // Analytics
  usageCount  Int      @default(0)
  successRate Float?
  avgLatency  Float?   // milliseconds
  
  // Metadata
  description String?
  category    String?  // "system", "response", "title"
  tags        String[] // ["production", "v2", "optimized"]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  // userId who created/updated
  
  // Relations
  versions    PromptVersion[]
  experiments PromptExperiment[]
  
  @@index([name, isActive])
  @@index([category])
}

model PromptVersion {
  id         String   @id @default(uuid())
  templateId String
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  version    Int
  content    String   @db.Text
  metadata   Json?
  
  // Change tracking
  changeLog  String?  @db.Text // What was changed
  createdBy  String?
  createdAt  DateTime @default(now())
  
  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

model PromptExperiment {
  id          String   @id @default(uuid())
  templateId  String
  template    PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  name        String   // "A/B Test v1 vs v2"
  variant     String   // "control", "variant-a", "variant-b"
  content     String   @db.Text
  
  // Experiment config
  trafficPercent Float @default(0) // 0-100
  isActive    Boolean  @default(false)
  
  // Results
  usageCount  Int      @default(0)
  successRate Float?
  avgLatency  Float?
  
  startDate   DateTime @default(now())
  endDate     DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([templateId, isActive])
  @@index([variant])
}

model PromptLog {
  id          String   @id @default(uuid())
  templateId  String
  
  // Request info
  promptName  String
  version     Int
  variant     String?  // For A/B testing
  
  // Performance
  latency     Int      // milliseconds
  success     Boolean
  error       String?  @db.Text
  
  // Context
  projectId   String?
  userId      String?
  
  createdAt   DateTime @default(now())
  
  @@index([templateId, createdAt])
  @@index([promptName, success])
  @@index([projectId])
}